<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Receta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/green_dark"
            android:layout_marginVertical="16dp"
            android:layout_gravity="center_horizontal"/>

        <!-- SECCIÓN 1: Ingredientes (Principales y Complementarios) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Información e Ingredientes"
                    android:textStyle="bold"
                    android:textColor="@color/green_normal"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_recipe_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_recipe_name"
                    android:inputType="textCapSentences"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/et_portions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_portions"
                        android:inputType="number"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/et_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:hint="@string/hint_time"
                        android:inputType="text"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingredientes (Principales y Complementarios)"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Contenedor dinámico de ingredientes -->
                <LinearLayout
                    android:id="@+id/container_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_add_ingredient"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Añadir Ingrediente"
                    android:textColor="@color/green_normal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN 2: Condimentos y Especias -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Condimentos y Especias"
                    android:textStyle="bold"
                    android:textColor="@color/green_normal"
                    android:layout_marginBottom="12dp"/>

                <!-- Contenedor dinámico de condimentos -->
                <LinearLayout
                    android:id="@+id/container_condiments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_add_condiment"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Añadir Condimento"
                    android:textColor="@color/green_normal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN 3: Elaboración -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Elaboración y Utensilios"
                    android:textStyle="bold"
                    android:textColor="@color/green_normal"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_utensils"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_utensils"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasos de Preparación"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Contenedor dinámico de pasos -->
                <LinearLayout
                    android:id="@+id/container_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_add_step"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Añadir Paso"
                    android:textColor="@color/green_normal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN 4: Multimedia -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Foto de la Receta"
                    android:textStyle="bold"
                    android:textColor="@color/green_normal"
                    android:layout_marginBottom="12dp"/>

                <ImageView
                    android:id="@+id/iv_recipe_image"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Imagen final" />

                <Button
                    android:id="@+id/btn_select_image"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_select_image" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_save_recipe"
            android:backgroundTint="@color/green_normal"
            android:textColor="@color/white"
            android:layout_marginBottom="32dp"
            app:cornerRadius="12dp"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>