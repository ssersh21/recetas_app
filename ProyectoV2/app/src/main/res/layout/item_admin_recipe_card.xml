<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#FFCDD2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_admin_thumb"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#EEEEEE"
            android:contentDescription="Imagen receta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_admin_recipe_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Receta"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_admin_recipe_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="30 min | 4 porciones"
                android:textSize="12sp"
                android:textColor="@color/gris"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_reports_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ 5 reportes acumulados"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/rojo"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_delete_recipe"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dar de baja"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/rojo"
            app:cornerRadius="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
